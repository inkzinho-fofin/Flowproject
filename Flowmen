<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Desafio de Natal — Blox Fruits</title>
<style>
:root{
  --bg:#08070d;--panel:#12101b;--panel2:#191625;--text:#f5f2ff;
  --muted:#aaa3bb;--pink:#ff3cac;--purple:#7c4dff;--green:#39e58c;
  --red:#ff5577;--border:#302a40;
}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;font-family:Inter,system-ui,Arial;background:
radial-gradient(circle at 20% 10%,#351344 0,transparent 35%),
radial-gradient(circle at 80% 80%,#1a1550 0,transparent 35%),var(--bg);color:var(--text)}
.wrap{width:min(980px,94%);margin:auto;padding:28px 0 50px}
header{text-align:center;margin-bottom:22px}
.logo{font-size:clamp(30px,7vw,58px);font-weight:900;letter-spacing:-2px}
.logo span{color:var(--pink)}
.subtitle{color:var(--muted)}
.card{background:rgba(18,16,27,.92);border:1px solid var(--border);border-radius:22px;padding:24px;box-shadow:0 15px 60px #0008;margin-bottom:18px}
h2{margin-top:0}
input{width:100%;padding:14px 15px;border-radius:12px;border:1px solid var(--border);background:#0b0910;color:white;font-size:16px;outline:none}
input:focus{border-color:var(--pink)}
label{display:block;color:#d9d2e8;font-weight:700;margin:14px 0 7px}
button{border:0;border-radius:12px;padding:13px 18px;background:linear-gradient(135deg,var(--pink),var(--purple));color:#fff;font-weight:900;cursor:pointer}
button:disabled{opacity:.45;cursor:not-allowed}
.btn-secondary{background:#262132}
.hidden{display:none!important}
.status{padding:12px 14px;border-radius:12px;background:#0d0b13;border:1px solid var(--border);margin:14px 0}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--red);margin-right:8px}
.dot.on{background:var(--green);box-shadow:0 0 12px var(--green)}
.players{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-top:14px}
.player{background:var(--panel2);border:1px solid var(--border);border-radius:14px;padding:13px}
.player small{display:block;color:var(--muted);margin-top:4px;word-break:break-all}
.online{color:var(--green);font-size:13px;font-weight:800}
.progress{height:8px;background:#292333;border-radius:99px;overflow:hidden;margin:12px 0 22px}
.progress i{display:block;height:100%;background:linear-gradient(90deg,var(--pink),var(--purple));width:0;transition:.3s}
.badge{display:inline-block;padding:6px 10px;border-radius:99px;background:#2a2038;color:#e6d9ff;font-size:12px;font-weight:900}
.question{font-size:24px;line-height:1.25;margin:22px 0}
.answers{display:grid;gap:11px}
.answer{text-align:left;background:#171320;border:1px solid var(--border);font-weight:700}
.answer:hover{border-color:#9a65ff;background:#211b2e}
.answer.correct{background:#123d2b;border-color:var(--green)}
.answer.wrong{background:#421b28;border-color:var(--red)}
.timer{font-size:22px;font-weight:900;color:#ffd166}
.note{font-size:13px;color:var(--muted);line-height:1.5}
.score{font-size:42px;font-weight:900;text-align:center}
footer{color:#777084;text-align:center;font-size:12px;margin-top:24px}
</style>
</head>
<body>
<div class="wrap">
<header>
  <div class="logo">DESAFIO <span>BLOX FRUITS</span></div>
  <div class="subtitle">Desafio de Natal • Parte 1 — Conhecimento</div>
</header>

<section id="register" class="card">
  <h2>🎄 Entre no desafio</h2>
  <p class="note">Cada participante deve abrir este site no próprio aparelho e registrar o Discord ID e o Nick. O jogo só libera quando houver pelo menos 3 jogadores online.</p>
  <label for="discordId">Discord ID</label>
  <input id="discordId" placeholder="Ex.: 123456789012345678" inputmode="numeric" maxlength="20">
  <label for="nick">Nick no Discord</label>
  <input id="nick" placeholder="Ex.: Inkzinho" maxlength="32">
  <button id="joinBtn" style="margin-top:16px">Entrar no lobby</button>
  <p id="registerMsg" class="note"></p>
</section>

<section id="lobby" class="card hidden">
  <h2>🎮 Lobby</h2>
  <div class="status"><span id="dot" class="dot"></span><b id="onlineText">0 jogadores online</b></div>
  <div id="players" class="players"></div>
  <button id="startBtn" disabled style="margin-top:18px">Aguardando 3 jogadores...</button>
  <p class="note">Se qualquer participante fechar/sair do site, a partida é pausada/encerrada para todos. O lobby usa presença em tempo real.</p>
</section>

<section id="quiz" class="card hidden">
  <div style="display:flex;justify-content:space-between;gap:10px;align-items:center">
    <span id="difficulty" class="badge">FÁCIL</span>
    <span id="timer" class="timer">20s</span>
  </div>
  <div class="progress"><i id="progress"></i></div>
  <div id="question" class="question"></div>
  <div id="answers" class="answers"></div>
  <p id="quizMsg" class="note"></p>
</section>

<section id="result" class="card hidden">
  <h2>🏁 Parte 1 concluída</h2>
  <div id="resultScore" class="score">0 / 10</div>
  <p id="resultText" style="text-align:center"></p>
  <div id="ranking" class="players"></div>
  <p class="note">A pontuação fica vinculada ao Discord ID usado no lobby. A próxima parte do desafio pode usar este resultado.</p>
</section>

<footer>Desafio privado • Não peça senha, token ou cookie do Discord.</footer>
</div>

<script type="module">
/*
  ============================================================
  CONFIGURAÇÃO ONLINE
  ============================================================
  Este arquivo usa Firebase Realtime Database para presença.
  1. Crie um projeto no Firebase.
  2. Ative Realtime Database.
  3. Crie um app Web.
  4. Cole o objeto firebaseConfig abaixo.
  5. Publique este HTML em um host HTTPS.

  Para uma versão sem Firebase, o lobby online entre aparelhos
  NÃO será confiável apenas com HTML/JS.
*/
const firebaseConfig = {
  apiKey: "COLE_SUA_API_KEY",
  authDomain: "SEU-PROJETO.firebaseapp.com",
  databaseURL: "https://SEU-PROJETO-default-rtdb.firebaseio.com",
  projectId: "SEU-PROJETO",
  storageBucket: "SEU-PROJETO.firebasestorage.app",
  messagingSenderId: "COLE_SEU_SENDER_ID",
  appId: "COLE_SEU_APP_ID"
};

const DEMO_MODE = Object.values(firebaseConfig).some(v => String(v).includes("COLE_") || String(v).includes("SEU-PROJETO"));

const questions = [
  {d:"FÁCIL",q:"Quantos mares existem atualmente em Blox Fruits?",a:["2","3","4","5"],c:1},
  {d:"FÁCIL",q:"Ao subir de nível, quantos pontos de atributo o jogador recebe?",a:["1","2","3","5"],c:2},
  {d:"FÁCIL",q:"Qual destes é um dos quatro mares/áreas de progressão principais de Blox Fruits?",a:["First Sea","Fourth Sea","Moon Sea","Void Sea"],c:0},

  {d:"MÉDIA",q:"Qual nível é associado ao acesso ao Third Sea?",a:["700","1000","1500","2000"],c:2},
  {d:"MÉDIA",q:"Em qual Sea ficam os caminhos de evolução Race V2 e V3?",a:["First Sea","Second Sea","Third Sea","Nenhuma"],c:1},
  {d:"MÉDIA",q:"A Race V4 está ligada principalmente a qual Sea?",a:["First Sea","Second Sea","Third Sea","Todas igualmente"],c:2},

  {d:"DIFÍCIL",q:"Qual destas NÃO é uma das quatro raças que podem ser recebidas ao entrar no jogo pela primeira vez?",a:["Human","Rabbit","Shark","Cyborg"],c:3},
  {d:"DIFÍCIL",q:"Qual raça é obtida por meio do puzzle relacionado ao Cyborg?",a:["Ghoul","Cyborg","Draco","Angel"],c:1},
  {d:"DIFÍCIL",q:"Qual destas é uma raça não natural que pode ser obtida através de uma quest própria?",a:["Human","Angel","Ghoul","Rabbit"],c:2},

  {d:"DESEMPATE",q:"Qual destas raças NÃO faz parte das quatro raças iniciais: Human, Rabbit, Shark e...?",a:["Angel","Ghoul","Human","Shark"],c:1}
];

let player = null;
let current = 0;
let score = 0;
let timer = null;
let timeLeft = 20;
let players = {};
let gameStarted = false;
let db = null;
let ref, onValue, set, onDisconnect, onChildAdded, onChildRemoved, remove;

const $ = id => document.getElementById(id);
function show(id){$(id).classList.remove("hidden")}
function hide(id){$(id).classList.add("hidden")}

function validate(){
  const id=$("discordId").value.trim(), nick=$("nick").value.trim();
  if(!/^\d{6,20}$/.test(id)) return "Digite um Discord ID numérico válido.";
  if(nick.length<2) return "Digite um nick com pelo menos 2 caracteres.";
  return "";
}

$("joinBtn").onclick = async () => {
  const err=validate();
  if(err){$("registerMsg").textContent=err;return}
  player={id:$("discordId").value.trim(),nick:$("nick").value.trim(),score:0};
  hide("register"); show("lobby");
  if(DEMO_MODE){
    // Modo demonstração: permite testar a interface sem Firebase.
    players[player.id]=player;
    renderPlayers();
    $("registerMsg").textContent="";
    $("startBtn").disabled=true;
    $("startBtn").textContent="Configure o Firebase para jogar online";
    return;
  }
  await initFirebase();
};

async function initFirebase(){
  const appMod = await import("https://www.gstatic.com/firebasejs/11.0.2/firebase-app.js");
  const dbMod = await import("https://www.gstatic.com/firebasejs/11.0.2/firebase-database.js");
  const {initializeApp}=appMod;
  ({getDatabase,ref,onValue,set,onDisconnect,remove}=dbMod);
  const app=initializeApp(firebaseConfig);
  db=getDatabase(app);
  const room="natal-blox-fruits-2026";
  const me=ref(db,`rooms/${room}/players/${player.id}`);
  const connected=ref(db,".info/connected");

  onValue(connected,snap=>{
    if(snap.val()===true){
      set(me,{id:player.id,nick:player.nick,score:0,online:true,joinedAt:Date.now()});
      onDisconnect(me).remove();
    }
  });

  onValue(ref(db,`rooms/${room}/players`),snap=>{
    players=snap.val()||{};
    renderPlayers();
    if(gameStarted && Object.keys(players).length<3) pauseGame("Um jogador saiu. A partida foi pausada.");
  });
}

function renderPlayers(){
  const arr=Object.values(players);
  $("onlineText").textContent=`${arr.length} jogador(es) online`;
  $("dot").classList.toggle("on",arr.length>=3);
  $("players").innerHTML=arr.map(p=>`
    <div class="player">
      <b>${escapeHtml(p.nick)}</b>
      <small>Discord ID: ${escapeHtml(p.id)}</small>
      <div class="online">● ONLINE</div>
    </div>`).join("");
  $("startBtn").disabled=arr.length<3 || gameStarted || DEMO_MODE;
  if(!gameStarted) $("startBtn").textContent=arr.length>=3?"Começar Parte 1":"Aguardando 3 jogadores...";
}
function escapeHtml(s){return s.replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}

$("startBtn").onclick=()=>{if(Object.keys(players).length>=3) startGame()};

function startGame(){
  gameStarted=true; current=0; score=0;
  hide("lobby");show("quiz");loadQuestion();
}
function loadQuestion(){
  clearInterval(timer);
  const x=questions[current];
  $("difficulty").textContent=x.d;
  $("question").textContent=`${current+1}. ${x.q}`;
  $("progress").style.width=((current)/questions.length*100)+"%";
  $("answers").innerHTML="";
  $("quizMsg").textContent="";
  x.a.forEach((ans,i)=>{
    const b=document.createElement("button");
    b.className="answer";b.textContent=ans;
    b.onclick=()=>answer(i,b);
    $("answers").appendChild(b);
  });
  timeLeft=20;$("timer").textContent=timeLeft+"s";
  timer=setInterval(()=>{
    timeLeft--;$("timer").textContent=timeLeft+"s";
    if(timeLeft<=0){clearInterval(timer);answer(-1,null)}
  },1000);
}
function answer(i,clicked){
  clearInterval(timer);
  const x=questions[current];
  [...$("answers").children].forEach((b,n)=>{
    b.disabled=true;
    if(n===x.c)b.classList.add("correct");
  });
  if(i===x.c){score++; if(clicked)clicked.classList.add("correct");}
  else if(clicked)clicked.classList.add("wrong");
  $("quizMsg").textContent=i===x.c?"✓ Resposta correta!":"✕ Resposta incorreta.";
  setTimeout(()=>{
    current++;
    if(current>=questions.length)finishGame();
    else loadQuestion();
  },900);
}
function finishGame(){
  hide("quiz");show("result");
  $("resultScore").textContent=`${score} / ${questions.length}`;
  $("resultText").textContent=score===10?"Perfeito!":score>=7?"Mandou muito bem!":score>=5?"Boa tentativa!":"Ainda dá para estudar mais os mares!";
  const arr=Object.values(players);
  $("ranking").innerHTML=arr.map(p=>`<div class="player"><b>${escapeHtml(p.nick)}</b><small>Pontuação online será sincronizada na versão Firebase.</small></div>`).join("");
}
function pauseGame(msg){
  clearInterval(timer);gameStarted=false;
  hide("quiz");show("lobby");
  $("quizMsg").textContent=msg;
  $("startBtn").textContent="Partida encerrada — aguardando 3 jogadores";
  $("startBtn").disabled=true;
  alert(msg);
}
window.addEventListener("beforeunload",()=>{
  // Firebase onDisconnect cuida da saída quando configurado.
});
</script>
</body>
</html>
